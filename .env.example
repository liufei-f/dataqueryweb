# Free LLM for the "AI check for new QTL data" option. Copy to .env and fill in ONE of these.
# With none set, the keyless Pollinations endpoint is used (slower, rate-limited).

# OpenRouter free models — free account at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Groq free tier — https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Optional: comma-separated model list to try in order, or any OpenAI-compatible endpoint.
# LLM_MODEL=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=...

# Fall back to keyless Pollinations when every model above fails (e.g. quota used up).
# LLM_FALLBACK=pollinations

# Characters of full text sent with each paper (default 60000 for LLM_BASE_URL endpoints).
# LLM_MAX_TEXT_CHARS=60000

# Let the model search the web when full text is missing (needs Responses API + web_search).
# LLM_WEB_SEARCH=true

# Auto-save: minimum AI confidence, and whether the fallback model may auto-save.
# AUTO_SAVE_MIN_CONFIDENCE=0.9
# AUTO_SAVE_FALLBACK=false
